<Window x:Class="CodexModelSwitcher.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex 模型切换器"
        Width="820"
        Height="650"
        MinWidth="740"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#F4F7FB"
        Loaded="OnWindowLoaded"
        Closed="OnWindowClosed">
    <Grid>
        <Grid x:Name="ContentArea" Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="4,0,4,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Codex 模型切换器" FontSize="28" FontWeight="SemiBold" />
                    <TextBlock Text="选择模型，自动写入配置并重启 ChatGPT" Margin="0,6,0,0" FontSize="14" Foreground="{StaticResource MutedTextBrush}" />
                </StackPanel>
                <Button Grid.Column="1" Content="刷新状态" Style="{StaticResource SecondaryButtonStyle}" Click="OnRefreshClick" VerticalAlignment="Center" />
            </Grid>

            <Border Grid.Row="1" Background="White" CornerRadius="14" Padding="20" Margin="0,0,0,16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Ellipse x:Name="StatusIndicator" Width="13" Height="13" Fill="#94A3B8" VerticalAlignment="Center" Margin="0,0,14,0" />
                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="CurrentStateText" Text="正在读取状态…" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock x:Name="CurrentModelText" Text="" Margin="0,4,0,0" Foreground="{StaticResource MutedTextBrush}" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" x:Name="KeyStatusText" Text="API Key：未保存" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" />
                </Grid>
            </Border>

            <Border Grid.Row="2" Background="White" CornerRadius="14" Padding="20" Margin="0,0,0,16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="DeepSeek API Key" FontSize="15" FontWeight="SemiBold" />
                        <Grid Margin="0,10,18,0">
                            <PasswordBox x:Name="ApiKeyPasswordBox"
                                         Height="38"
                                         Padding="10,7"
                                         FontSize="14"
                                         PasswordChar="*"
                                         PasswordChanged="OnApiKeyPasswordChanged"
                                         BorderBrush="{StaticResource BorderBrush}"
                                         VerticalContentAlignment="Center" />
                            <TextBox x:Name="ApiKeyTextBox"
                                     Height="38"
                                     Padding="10,7"
                                     FontSize="14"
                                     TextChanged="OnApiKeyTextChanged"
                                     BorderBrush="{StaticResource BorderBrush}"
                                     VerticalContentAlignment="Center"
                                     Visibility="Collapsed" />
                        </Grid>
                        <Grid Margin="0,8,18,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="MaskApiKeyCheckBox"
                                      Content="使用 * 隐藏 API Key"
                                      IsChecked="True"
                                      Checked="OnApiKeyMaskChanged"
                                      Unchecked="OnApiKeyMaskChanged"
                                      VerticalContentAlignment="Center" />
                            <TextBlock x:Name="ApiKeySaveStatusText"
                                       Grid.Column="1"
                                       Text="未保存"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Text="Key 将安全存入 Windows 凭据库；取消隐藏后可查看完整值。"
                                   Margin="0,7,0,0"
                                   FontSize="12"
                                   Foreground="{StaticResource MutedTextBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <Button x:Name="SaveKeyButton"
                                Content="保存 API Key"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="OnSaveKeyClick" />
                        <Button x:Name="ClearKeyButton"
                                Content="清除已保存 Key"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="OnClearKeyClick"
                                Margin="0,8,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Grid.Row="3" Text="选择目标模型" FontSize="16" FontWeight="SemiBold" Margin="4,0,0,8" />

            <UniformGrid Grid.Row="4" Columns="4" Margin="-5,0,-5,0" VerticalAlignment="Top">
                <Button Tag="gpt" Style="{StaticResource ModelButtonStyle}" Click="OnSwitchClick" Height="126">
                    <StackPanel>
                        <TextBlock Text="GPT" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="恢复原配置" Margin="0,8,0,0" FontSize="12" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Tag="flash" Style="{StaticResource ModelButtonStyle}" Click="OnSwitchClick" Height="126">
                    <StackPanel>
                        <TextBlock Text="Flash" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="快速响应" Margin="0,8,0,0" FontSize="12" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Tag="pro" Style="{StaticResource ModelButtonStyle}" Click="OnSwitchClick" Height="126">
                    <StackPanel>
                        <TextBlock Text="Pro" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="复杂任务" Margin="0,8,0,0" FontSize="12" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Tag="vision" Style="{StaticResource ModelButtonStyle}" Click="OnSwitchClick" Height="126">
                    <StackPanel>
                        <TextBlock Text="Vision" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="实验版本" Margin="0,8,0,0" FontSize="12" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>
            </UniformGrid>

            <Grid Grid.Row="5" Margin="4,18,4,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <CheckBox x:Name="AutoRestartCheckBox"
                          Content="切换后自动重启 ChatGPT"
                          IsChecked="True"
                          FontSize="14"
                          VerticalContentAlignment="Center" />
                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ResultText" Text="准备就绪" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" x:Name="CodexHomeText" Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="360" />
                </Grid>
            </Grid>
        </Grid>

        <Border x:Name="BusyOverlay" Background="#CCF4F7FB" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="300">
                <TextBlock x:Name="BusyText" Text="正在切换…" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <ProgressBar Margin="0,18,0,0" Height="7" IsIndeterminate="True" Foreground="{StaticResource PrimaryBrush}" />
                <TextBlock Text="请不要关闭此窗口" Margin="0,12,0,0" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
